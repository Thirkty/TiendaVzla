# Copia este archivo como .env y completa tus valores.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA@localhost:5432/tiendavzla
CORS_ORIGINS=http://localhost:3000

# Tasa inicial: solo se usa si la base de datos aún no tiene ninguna tasa.
BCV_RATE=40
# La tasa oficial se lee de bcv.org.ve (respaldo: DolarApi) cada RATE_REFRESH_HOURS horas.
BCV_AUTO_UPDATE=true
RATE_REFRESH_HOURS=1

# Minutos que una orden sin pagar aparta el stock antes de cancelarse sola
ORDER_TTL_MINUTES=120

# Clave del panel /admin: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=genera-una-clave-larga-y-aleatoria
SQL_ECHO=false
